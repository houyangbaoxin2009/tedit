type tie<tsh>
// build.tsh.tie —— tedit (role tsh) build driver
// usage: tsh_main.exe -f build.tsh.tie
//        (set env TIE_BUILD_NOCACHE=1 to pass --no-cache to tiec)
// Requires the tiec compiler as a sibling checkout of this repo:
//   ../tiec/compiler/tiec.exe   (stage0 is enough)
// Builds one assembly from src/*.tie:
//   src\tedit_main.exe   tedit core host (session-layer subset)
// NOTE(tsh-limitation): the tsh interp cannot issue a conditional `exit N`,
// so on the tiec-missing / compile-fail path this logs the problem but the
// process still returns 0.
var root = cwd()
var tiec = path_join(root, "..\\tiec\\compiler\\tiec.exe")
if !file_exists(tiec) { println("[build] tiec stage0 not found: " + tiec) }
if !file_exists(tiec) { println("[build] please clone tie-lang/tiec as a sibling of this repo.") }
var opts = ""
if get_env("TIE_BUILD_NOCACHE") == "1" { opts = "--no-cache " }
println("[build] compiling src/tedit_main.tie")
var rc1 = exec_code("cd /d \"" + root + "\" && ..\\tiec\\compiler\\tiec.exe " + opts + "\"src/tedit_main.tie\"")
if rc1 != 0 { println("[build] compile failed: src/tedit_main.tie (rc=" + to_string(rc1) + ")") }
println("[build] done: src\\tedit_main.exe (tedit core host)")
exit 0
