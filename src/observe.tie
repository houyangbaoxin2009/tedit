type tie<logic>
import "./session.tie"
import "./sh_util.tie"
// src/observe.tie —— 求值后端配置 + 观测骨架模块（L0）
// --------------------------------------------------------------
// 观测台 / 调试前端（断点·单步·栈帧内省）/ 动态加载交互 / 可配置 REPL 执行后端。
// 本模块**务实定界**：
//   · `set eval-backend interp`（interp 现役默认；后端经配置位管理）；
//   · tieir 观测/调试/动态加载在依赖的能力落地前**注明接口等待**，只留骨架与
//     诊断文案，不造占位假实现。
//
// EN: observe module — configurable eval backend + observation skeleton.
// interp is the active backend (config-managed). tieir observation / debug /
// dynamic loading are declared "interface pending" until the underlying
// capabilities land — no fake stubs.

namespace observe {

// 当前求值后端（从会话配置读取；默认 interp）。
pub func o_backend() -> string {
    var cfg = session.ss_load_cfg()
    var b = session.ss_cfg_get(cfg, "eval.backend")
    if b == "" {
        return "interp"
    }
    return b
}

// 设置求值后端。interp 现役。返回执行结果/提示文本。
pub func o_set_backend(name: string) -> string {
    var n = sh_util.u_trim(name)
    if n == "interp" {
        set_cfg("interp")
        return "eval-backend: interp（现役，tie-interp 快速路径）"
    }
    return "eval-backend: 未知后端 '" + n + "'（可选 interp）"
}

// 把当前后端写回配置（td 资产）。
func set_cfg(b: string) {
    var cfg = session.ss_load_cfg()
    var key = "eval.backend"
    var out = table_new_string()
    var found = false
    for r in cfg {
        if key_eq(r, key) {
            table_push(out, key + "=" + b)
            found = true
        } else {
            table_push(out, r)
        }
    }
    if !found {
        table_push(out, key + "=" + b)
    }
    session.ss_save_cfg(out)
}

func key_eq(r: string, key: string) -> bool {
    var n = str_len(key)
    if str_len(r) > n && sh_util.u_sub(r, 0, n) == key {
        var c = str_char(r, n)
        if c == "=" {
            return true
        }
    }
    return false
}

// ---- tieir 观测/调试前端（骨架）----
// 反汇编：需要 tieir 字节码产物才能指令级展示。
// 本批优雅返回「接口等待」说明，不伪造反汇编输出。
pub func o_disasm(ir: string) -> string {
    return "[observe] tieir 反汇编：接口等待 — 需要 tieir 字节码产物，本批未接入"
}

// 断点 / 单步：需要执行钩子（invoke/step）。
pub func o_step(name: string) -> string {
    return "[observe] 调试前端（断点/单步/栈帧内省）：接口等待 — 依赖执行钩子 invoke/step"
}

// 动态加载交互：待动态加载方案定案后接入。
pub func o_dynload(module: string) -> string {
    return "[observe] 动态加载交互：接口等待 — 待动态加载方案定案"
}

}   // namespace observe
